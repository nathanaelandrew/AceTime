@inherits LayoutComponentBase
@inject NavigationManager NavManager

@{
    var uri = NavManager.ToBaseRelativePath(NavManager.Uri).ToLower();
    bool isAuthPage = string.IsNullOrEmpty(uri) || uri == "register";

    string GetActiveClass(string pageName) {
        bool isActive = (string.IsNullOrEmpty(uri) && pageName == "home") || uri.Contains(pageName);
        return isActive 
            ? "flex items-center gap-3 px-4 py-3 rounded-2xl bg-orange-500 text-white font-bold shadow-lg shadow-orange-500/20 transition-all scale-[1.02]" 
            : "flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-400 font-bold hover:bg-white/5 hover:text-white transition-all";
    }
}

<div class="flex h-screen overflow-hidden font-sans">
    @if (!isAuthPage)
    {
        <!-- DESKTOP SIDEBAR -->
        <aside class="hidden lg:flex flex-col w-72 bg-[#0F172A] p-8 text-white shrink-0 border-r border-white/5">
            <div class="text-2xl font-[800] italic tracking-tighter mb-12 select-none">
                Ace<span class="text-slate-500 not-italic font-[400]">Time</span>
            </div>

            <nav class="flex-1 space-y-2">
    <a href="/home" class="@GetActiveClass("home")">
        <span>🏠</span> Home
    </a>
    <a href="/profile" class="@GetActiveClass("profile")">
        <span>👤</span> My Profile
    </a>
    <a href="/openplays" class="@GetActiveClass("openplays")">
        <span>🎾</span> Open Plays
    </a>
    <a href="/tournaments" class="@GetActiveClass("tournaments")">
        <span>🏆</span> Tournaments
    </a>
    <a href="/leaderboard" class="@GetActiveClass("leaderboard")">
        <span>📊</span> Rankings
    </a>
    <!-- ADD THIS: So you can access the Rating feature -->
    <a href="/history" class="@GetActiveClass("history")">
        <span>🕒</span> Activity History
    </a>
    <a href="/myclubs" class="@GetActiveClass("myclubs")">
        <span>🤝</span> My Clubs
    </a>
</nav>

<div class="pt-8 border-t border-white/10">
    <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-orange-400 font-[900] uppercase text-[11px] tracking-widest hover:bg-red-500/10 transition-all">
        <span>🚪</span> Log Out
    </a>
</div>
        </aside>
    }

    <main class="flex-1 overflow-y-auto bg-slate-50 relative">
        @Body
    </main>
</div>