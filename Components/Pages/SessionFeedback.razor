@page "/session-feedback/{SessionName}"
@rendermode InteractiveServer
@inject NavigationManager NavManager

<div class="p-10 max-w-3xl mx-auto font-['Plus_Jakarta_Sans'] pb-32">
    
    <!-- Header -->
    <header class="mb-12">
        <button @onclick='() => NavManager.NavigateTo("/history")' class="text-slate-400 font-bold text-[10px] uppercase tracking-[0.3em] hover:text-orange-500 transition-all mb-4 flex items-center gap-2">
            ← Back to History
        </button>
        <h1 class="text-5xl font-[800] tracking-tighter text-slate-900 uppercase italic">Rate the Session</h1>
        <p class="text-slate-400 font-medium mt-2">Share your feedback for <span class="text-slate-900 font-bold">@SessionName</span></p>
    </header>

    <div class="bg-white rounded-[48px] p-12 border border-slate-100 shadow-sm space-y-12">
        
        <!-- 1. STAR RATING -->
        <div class="text-center">
            <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-6">Overall Experience</h3>
            <div class="flex justify-center gap-4">
                @for (int i = 1; i <= 5; i++)
                {
                    int starIndex = i;
                    <button @onclick="() => SetRating(starIndex)" class="group transition-transform active:scale-90">
                        <span class="text-5xl @(starIndex <= currentRating ? "text-orange-500" : "text-slate-100") hover:text-orange-300 transition-colors">
                            ★
                        </span>
                    </button>
                }
            </div>
            <p class="mt-4 text-xs font-bold text-slate-400 uppercase tracking-widest">
                @(currentRating == 0 ? "Select a rating" : $"{currentRating} / 5 Stars")
            </p>
        </div>

        <!-- 2. COMMENT AREA -->
        <div>
            <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] mb-4 block italic">Public Comment</label>
            <textarea @bind="newComment" rows="4" 
                      class="w-full bg-slate-50 border-none rounded-[32px] py-6 px-8 text-sm font-medium text-slate-700 outline-none focus:ring-2 focus:ring-orange-500/20 transition-all leading-relaxed"
                      placeholder="Was the host organized? How were the courts?"></textarea>
        </div>

        <!-- Submit Button -->
        <button @onclick="SubmitFeedback" 
                class="w-full py-5 bg-[#111111] text-white rounded-2xl font-[900] uppercase tracking-[0.1em] hover:bg-orange-600 transition-all shadow-xl shadow-orange-500/10 active:scale-95">
            Submit Review
        </button>
    </div>

    <!-- 3. RECENT COMMENTS (Mock Feedback Loop) -->
    @if (submittedComments.Any())
    {
        <div class="mt-20 space-y-6 animate-in slide-in-from-bottom-4 duration-700">
            <h4 class="text-xs font-black text-slate-400 uppercase tracking-[0.2em] mb-8 border-l-4 border-orange-500 pl-4">Recent Feedback</h4>
            @foreach (var comment in submittedComments)
            {
                <div class="bg-white p-8 rounded-[32px] border border-slate-100 shadow-sm flex gap-6">
                    <div class="w-12 h-12 rounded-full bg-slate-900 flex items-center justify-center text-white font-bold shrink-0 shadow-lg">
                        JD
                    </div>
                    <div>
                        <div class="flex gap-1 mb-2">
                            @for(int s=0; s<comment.Rating; s++){ <span class="text-orange-500 text-xs">★</span> }
                        </div>
                        <p class="text-slate-600 text-sm font-medium leading-relaxed italic">"@comment.Text"</p>
                        <p class="text-[9px] font-black text-slate-300 uppercase mt-4 tracking-widest">Posted Just Now</p>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string SessionName { get; set; } = "Pickleball Open Play";
    
    private int currentRating = 0;
    private string newComment = "";
    
    // Simple logic for the assignment requirements
    private List<UserReview> submittedComments = new();

    private void SetRating(int rating) => currentRating = rating;

    private void SubmitFeedback()
    {
        if (currentRating > 0 && !string.IsNullOrWhiteSpace(newComment))
        {
            submittedComments.Insert(0, new UserReview { Rating = currentRating, Text = newComment });
            newComment = ""; // Clear input
            currentRating = 0; // Reset stars
        }
    }

    public class UserReview {
        public int Rating { get; set; }
        public string Text { get; set; }
    }
}